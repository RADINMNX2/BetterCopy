{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "better_copy_gui",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "BetterCopy",
        "width": 320,
        "height": 125,
        "center": true,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "label": "main",
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
