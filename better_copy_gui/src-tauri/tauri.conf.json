{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "better_copy_gui",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "BetterCopy",
        "width": 380,
        "height": 250,
        "minWidth": 320,
        "minHeight": 200,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "label": "main",
        "alwaysOnTop": true
      },
      {
        "title": "BetterCopy Settings",
        "url": "settings.html",
        "width": 360,
        "height": 430,
        "center": true,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "label": "settings",
        "skipTaskbar": true,
        "alwaysOnTop": true
      },
      {
        "title": "BetterCopy Menu",
        "url": "tray-menu.html",
        "width": 244,
        "height": 372,
        "center": false,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "label": "tray-menu",
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
