{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BetterCopy Setup",
  "version": "0.1.0",
  "identifier": "com.radinmnx2.bettercopy.installer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "BetterCopy Setup",
        "width": 620,
        "height": 440,
        "center": true,
        "resizable": false,
        "fullscreen": false,
        "visible": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "label": "main",
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}